// ⚠️ File này DÙNG CHUNG cho project Firebase bieu-quyet-c964c, phải GIỐNG HỆT ở 2 repo:
//   - E:/Website/bieu-quyet-hoi-nghi  (app Biểu quyết hội nghị)
//   - E:/Website/vanbannhatruong      (app Văn bản nhà trường)
// Sửa ở repo nào thì copy nguyên file sang repo kia rồi mới deploy — deploy lệch sẽ
// xoá rules của app còn lại. Kiểm tra: node scripts/check-firebase-sync.mjs (repo vanbannhatruong).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Subcollection tài liệu
    match /meeting_documents/{meetingId}/documents/{docId} {
      allow read, write: if true;
    }

    // Activity logs
    match /meeting_documents/{meetingId}/activity_logs/{logId} {
      allow read, write: if true;
    }

    // Tài khoản đại biểu: admin quản lý toàn bộ, đại biểu chỉ đọc hồ sơ của chính mình
    match /delegate_accounts/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.token.email == 'admin-bachxa@bieuquyet.com');
      allow write: if request.auth != null
        && request.auth.token.email == 'admin-bachxa@bieuquyet.com';
    }

    // ============================================================
    // App: Văn bản nhà trường (repo E:\Website\vanbannhatruong)
    //
    // Mọi collection có tiền tố "vb". GV xem CÔNG KHAI (không đăng nhập):
    // danh sách trường + văn bản. Người quản lý trường đăng nhập Google; quyền
    // của 1 trường = email nằm trong vbSchoolEditors/{slug}.emails (doc này
    // KHÔNG công khai để không lộ email). HT tự đăng ký trường.
    // ============================================================
    function vbSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function vbEmail() {
      return request.auth.token.email.lower();
    }

    // Quản trị toàn hệ thống (xoá trường rác) — khớp ADMIN_EMAILS trong src/constants/site.ts.
    function vbIsAdmin() {
      return vbSignedIn() && vbEmail() in ['thaygiaotin1990@gmail.com'];
    }

    function vbEditorsPath(slug) {
      return /databases/$(database)/documents/vbSchoolEditors/$(slug);
    }

    function vbIsEditor(slug) {
      return vbSignedIn() && exists(vbEditorsPath(slug)) && vbEmail() in get(vbEditorsPath(slug)).data.emails;
    }

    // Khớp SLUG_PATTERN trong src/utils/text.ts.
    function vbValidSlug(slug) {
      return slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && slug.size() >= 3 && slug.size() <= 60;
    }

    function vbValidSchoolInfo(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 150
        && d.level is string && d.level.size() > 0 && d.level.size() <= 30
        && d.area is string && d.area.size() <= 150
        && d.updatedAt is int;
    }

    function vbValidDoc(d) {
      return d.keys().hasOnly(['title', 'docForm', 'category', 'driveUrl', 'createdAt', 'createdBy', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.docForm is string && d.docForm.size() > 0 && d.docForm.size() <= 50
        && d.category is string && d.category.size() > 0 && d.category.size() <= 50
        && d.driveUrl is string && d.driveUrl.matches('^https://.+') && d.driveUrl.size() <= 2000
        && d.createdAt is int && d.updatedAt is int;
    }

    // Trường: doc ID = slug (= đường dẫn /truong/{slug}), nên tự không trùng.
    // Tạo CÙNG 1 batch với vbSchoolEditors/{slug} (getAfter kiểm chéo). Set lên
    // slug đã có = update → người lạ bị chặn, không chiếm được trường khác.
    match /vbSchools/{slug} {
      allow read: if true;
      allow create: if vbSignedIn() && vbValidSlug(slug)
        && request.resource.data.keys().hasOnly(['name', 'level', 'area', 'createdBy', 'createdAt', 'updatedAt'])
        && vbValidSchoolInfo(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is int
        && getAfter(vbEditorsPath(slug)).data.emails == [vbEmail()];
      allow update: if (vbIsEditor(slug) || vbIsAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'level', 'area', 'updatedAt'])
        && vbValidSchoolInfo(request.resource.data);
      allow delete: if vbIsEditor(slug) || vbIsAdmin();

      // Văn bản: chỉ tên + hình thức + loại + link Drive (file thật nằm trên Drive).
      match /docs/{docId} {
        allow read: if true;
        allow create: if vbIsEditor(slug)
          && vbValidDoc(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if vbIsEditor(slug)
          && vbValidDoc(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if vbIsEditor(slug) || vbIsAdmin();
      }
    }

    // Danh sách email quản lý 1 trường — KHÔNG công khai. Người quản lý đọc được
    // doc có email của chính mình (query array-contains email để tìm "trường của tôi").
    // Mọi email trong danh sách ngang quyền; luôn còn ≥ 1 email.
    match /vbSchoolEditors/{slug} {
      allow read: if vbIsAdmin() || (vbSignedIn() && vbEmail() in resource.data.emails);
      // Chỉ tạo khi đăng ký trường mới (trường chưa tồn tại trước batch), danh sách = đúng email người đăng ký.
      allow create: if vbSignedIn() && vbValidSlug(slug)
        && !exists(/databases/$(database)/documents/vbSchools/$(slug))
        && getAfter(/databases/$(database)/documents/vbSchools/$(slug)).data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['emails', 'updatedAt'])
        && request.resource.data.emails == [vbEmail()];
      allow update: if (vbIsEditor(slug) || vbIsAdmin())
        && request.resource.data.keys().hasOnly(['emails', 'updatedAt'])
        && request.resource.data.emails is list
        && request.resource.data.emails.size() >= 1
        && request.resource.data.emails.size() <= 20;
      allow delete: if vbIsEditor(slug) || vbIsAdmin();
    }
  }
}
